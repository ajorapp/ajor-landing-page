<div class="band-wrap" id="download">
  <div class="band band-dark" data-reveal>
    <div class="band-dots" aria-hidden="true"></div>

    <div class="band-head">
      <span class="eyebrow" data-r="0">Download àjọr</span>
      <h2 data-r="100">Start saving in minutes.</h2>
      <p class="band-body" data-r="200">Free to download on iPhone and Android. Sign up with your phone number and start or join a group the same day.</p>
      <div class="stores" data-r="320">
        <a class="store" href="#appstore">
          <%- include('apple-icon', { size: 22 }) %>
          <span><span class="store-sub">Download on the</span><span class="store-name">App Store</span></span>
        </a>
        <a class="store" href="#googleplay">
          <svg width="20" height="22" viewBox="0 0 20 22" aria-hidden="true"><path d="M1.2 0.6 11.4 11 1.2 21.4C0.8 21.2 0.5 20.7 0.5 20.1V1.9C0.5 1.3 0.8 0.8 1.2 0.6Z" fill="currentColor"/><path d="M14.7 7.6 11.4 11l3.3 3.4 3.9-2.2c1.1-.6 1.1-1.8 0-2.4l-3.9-2.2Z" fill="currentColor" opacity=".75"/><path d="M1.2 0.6c.3-.1.7-.1 1.1.1l12.4 6.9L11.4 11 1.2 0.6Z" fill="currentColor" opacity=".55"/><path d="M1.2 21.4 11.4 11l3.3 3.4-12.4 6.9c-.4.2-.8.2-1.1.1Z" fill="currentColor" opacity=".4"/></svg>
          <span><span class="store-sub">Get it on</span><span class="store-name">Google Play</span></span>
        </a>
      </div>
    </div>

    <div class="steps">
      <div class="step" data-r="300"><span class="step-n">1</span><span class="step-text"><span class="step-title">Download the app</span><span class="step-sub">From the App Store or Google Play.</span></span></div>
      <div class="step" data-r="420"><span class="step-n">2</span><span class="step-text"><span class="step-title">Verify your number</span><span class="step-sub">A 6-digit code confirms it’s you.</span></span></div>
      <div class="step" data-r="540"><span class="step-n">3</span><span class="step-text"><span class="step-title">Start or join a group</span><span class="step-sub">Or set a savings target of your own.</span></span></div>
    </div>
  </div>
</div>
