<header class="site">
  <div class="site-inner">

    <a class="wordmark" href="#">àjọr</a>

    <nav class="site-nav">
      <a href="#savings">Savings</a>
      <a href="#security">Security</a>
      <a href="#faq">FAQ</a>
      <a href="#terms">Terms</a>
      <a href="#privacy">Privacy</a>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to dark mode">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6z"/></svg>
      </button>

      <%- include('download-button', { size: 17, cls: 'btn-sm header-download' }) %>

      <button class="icon-btn menu-btn" type="button" data-menu-open aria-label="Open menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="drawer-root" data-drawer aria-hidden="true">
  <div class="drawer-scrim" data-menu-close></div>
  <div class="drawer" role="dialog" aria-label="Menu">
    <div class="drawer-head">
      <span class="wordmark wordmark-sm">àjọr</span>
      <button class="icon-btn" type="button" data-menu-close aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <nav class="drawer-nav">
      <a href="#savings" data-menu-close>Savings<span>&rarr;</span></a>
      <a href="#security" data-menu-close>Security<span>&rarr;</span></a>
      <a href="#faq" data-menu-close>FAQ<span>&rarr;</span></a>
      <a href="#terms" data-menu-close>Terms<span>&rarr;</span></a>
      <a href="#privacy" data-menu-close>Privacy<span>&rarr;</span></a>
    </nav>

    <div class="drawer-foot">
      <%- include('download-button', { size: 20, cls: 'btn-lg' }) %>
    </div>
  </div>
</div>
