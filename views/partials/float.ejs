<div class="float float-<%= pos %>" data-float="<%= screen %>" data-delay="<%= delay %>">
  <span class="float-icon float-icon-<%= tone %>"><%- icon %></span>
  <span class="float-text">
    <span class="float-title"><%= title %></span>
    <span class="float-sub"><%= sub %></span>
  </span>
</div>
